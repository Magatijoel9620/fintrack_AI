rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // FinAI is deliberately single-account: the business document ID is the
    // Firebase Auth UID. No memberships, invitations or user roles are used.
    function businessOwner(businessId) {
      return signedIn()
        && request.auth.uid == businessId
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.id == request.auth.uid;
    }

    function activeSubscription(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId))
        && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.subscription.status == 'active'
          || (
            get(/databases/$(database)/documents/businesses/$(businessId)).data.subscription.status == 'trialing'
            && get(/databases/$(database)/documents/businesses/$(businessId)).data.subscription.trialEndsAt > request.time
          )
        );
    }

    function finiteNonNegative(value, maximum) {
      return value is number && value >= 0 && value <= maximum;
    }

    function validContact(data, businessId) {
      return data.businessId == businessId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && finiteNonNegative(data.balance, 1000000000000);
    }

    match /businesses/{businessId} {
      // Business provisioning is performed by the trusted Functions backend.
      allow create: if false;
      allow get: if businessOwner(businessId);
      allow list: if false;
      allow update: if businessOwner(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.subscription == resource.data.subscription
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'email', 'address', 'taxNumber', 'logoUrl', 'currency', 'monthlyBudget'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.currency in ['KES', 'USD', 'EUR', 'GBP', 'JPY']
        && (!('monthlyBudget' in request.resource.data) || finiteNonNegative(request.resource.data.monthlyBudget, 1000000000000));
      allow delete: if false;

      match /products/{id} {
        // Product creation, edits, quantity changes and removal use trusted
        // Functions so inventory balances cannot be changed without a ledger entry.
        allow read: if businessOwner(businessId);
        allow create, update, delete: if false;
      }

      match /categories/{id} {
        allow read: if businessOwner(businessId);
        allow create, update, delete: if businessOwner(businessId) && activeSubscription(businessId);
      }

      match /suppliers/{id} {
        allow read: if businessOwner(businessId);
        allow create: if businessOwner(businessId) && activeSubscription(businessId)
          && request.resource.data.id == id && validContact(request.resource.data, businessId);
        allow update: if businessOwner(businessId) && activeSubscription(businessId)
          && request.resource.data.id == resource.data.id && validContact(request.resource.data, businessId);
        allow delete: if businessOwner(businessId) && activeSubscription(businessId);
      }

      match /customers/{id} {
        allow read: if businessOwner(businessId);
        allow create: if businessOwner(businessId) && activeSubscription(businessId)
          && request.resource.data.id == id && validContact(request.resource.data, businessId);
        allow update: if businessOwner(businessId) && activeSubscription(businessId)
          && request.resource.data.id == resource.data.id && validContact(request.resource.data, businessId);
        allow delete: if businessOwner(businessId) && activeSubscription(businessId);
      }

      // Posted documents are created atomically by trusted Functions. Clients
      // cannot amend or delete financial history after it has been recorded.
      match /sales/{id} {
        allow read: if businessOwner(businessId);
        allow write: if false;
      }
      match /purchases/{id} {
        allow read: if businessOwner(businessId);
        allow write: if false;
      }
      match /payments/{id} {
        allow read: if businessOwner(businessId);
        allow write: if false;
      }
      match /stockMovements/{id} {
        allow read: if businessOwner(businessId);
        // Append-only ledger writes are performed by Admin SDK Functions.
        allow create, update, delete: if false;
      }

      match /expenses/{id} {
        allow read: if businessOwner(businessId);
        allow create: if businessOwner(businessId) && activeSubscription(businessId)
          && request.resource.data.id == id
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000000000
          && request.resource.data.merchant is string
          && request.resource.data.merchant.size() > 0
          && request.resource.data.merchant.size() <= 160
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 80
          && request.resource.data.date is string;
        allow update: if businessOwner(businessId) && activeSubscription(businessId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000000000
          && request.resource.data.merchant is string
          && request.resource.data.merchant.size() > 0
          && request.resource.data.category is string
          && request.resource.data.date is string;
        allow delete: if businessOwner(businessId) && activeSubscription(businessId);
      }

      match /subscriptionPaymentRequests/{id} {
        allow read: if businessOwner(businessId);
        allow create: if businessOwner(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.provider == 'mpesa_manual'
          && request.resource.data.status == 'pending_review'
          && request.resource.data.reference is string
          && request.resource.data.reference.matches('^[A-Z0-9]{8,16}$')
          && request.resource.data.requestedPlan in ['starter', 'growth', 'business']
          && request.resource.data.requestedAmountKes in [500, 1000, 2000];
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Platform administrator is a separate, trusted Firebase custom claim.
    match /platformMetrics/{documentId} {
      allow read: if signedIn() && request.auth.token.platformAdmin == true;
      allow write: if false;
    }
    match /platformAudit/{documentId} {
      allow read: if signedIn() && request.auth.token.platformAdmin == true;
      allow write: if false;
    }
    match /platformSettings/{documentId} {
      allow read: if signedIn() && request.auth.token.platformAdmin == true;
      allow write: if false;
    }
  }
}
