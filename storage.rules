rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /business-logos/{businessId}/{fileName} {
      // A logo is private to the single account that owns its business UID.
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create, update: if request.auth != null
        && request.auth.uid == businessId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == businessId;
    }
  }
}
